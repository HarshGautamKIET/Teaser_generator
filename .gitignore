yarn-error.log*
pnpm-debug.log*

# ---------- Database ----------
*.db
*.sqlite
*.sqlite3
*.db-journal

# ---------- Media (source videos & generated teasers) ----------
# Anchored to the repo root: unanchored patterns also matched the backend
# source packages backend/app/media/ and backend/app/storage/.
/uploads/
/generated/
/media/
/storage/
*.mp4
*.mov
*.mkv
*.avi
*.webm
*.srt
*.vtt
*.ass
!**/.gitkeep

# ---------- Logs ----------
*.log
logs/

# ---------- OS / Editor ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# The design set stays local, with one exception: the decisions log is the
# record of why this project is shaped the way it is, and a copy that exists
# only on one machine is not a record. Listed as `docs/*` rather than `docs/`
# so git descends into the directory far enough to see the negation.
docs/*
!docs/DECISIONS.md

# ---------- Self-hosted Supabase (docker/supabase) ----------
# Vendored from self-hosted/v0.8.0. The stack itself is committed; its
# generated secrets, database files, and version stamp are not.
docker/supabase/volumes/db/data/
docker/supabase/volumes/storage/
docker/supabase/.supabase-version


.playwright-mcp

# Personal Claude Code state stays local; the shared hook does not. The
# SessionStart hook in settings.json is what keeps docs/DECISIONS.md current,
# so it has to reach everyone working on the repository rather than only the
# machine it was written on.
.claude/*
!.claude/settings.json


# Playwright run output. `screenshots/` is written fresh by e2e/flow.spec.js on
# every run and `test-results/` holds traces of failures, so neither is a record
# of anything - the trace alone is several megabytes per failed run.
e2e/screenshots/
e2e/test-results/
