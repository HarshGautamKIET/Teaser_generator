# ---------------------------------------------------------------
# AI Video Teaser Generator — example environment configuration
# Copy to .env and fill in real values.  Never commit .env.
#   cp .env.example .env
# ---------------------------------------------------------------

# ---------- AI ----------
# "gemini" for real analysis; "fake" produces clearly-labelled offline
# placeholders for rehearsing the demo without network access.
AI_PROVIDER=gemini

# Required for live AI analysis.  Get a key from Google AI Studio.
GEMINI_API_KEY=
# Optional comma-separated pool, tried in order.  When one key hits its quota
# the next takes over for the rest of the process's life; restarting resets to
# the first.  GEMINI_API_KEY is appended automatically, so setting only that
# one still works.
GEMINI_API_KEYS=
# Must be a model that supports multimodal video input.
GEMINI_MODEL=gemini-3.6-flash

# ---------- Server ----------
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API (the Vite dev server).
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# ---------- Supabase / Database ----------
# The Supabase stack lives in docker/supabase and is configured by its OWN .env,
# generated by `sh utils/generate-keys.sh` + `sh utils/add-new-auth-keys.sh`.
# The values below are the handful this application needs; copy them across with
# `cd docker/supabase && sh run.sh secrets`.

# Postgres superuser password, used only by the one-shot `migrate` service.
# Must match POSTGRES_PASSWORD in docker/supabase/.env.
POSTGRES_PASSWORD=

# Password for `teaser_app`, the role the backend logs in as. Any strong value;
# the migrate service creates the role with it. Generate with:
#   openssl rand -hex 24
APP_DB_PASSWORD=

# Used when running the backend on the host rather than in docker. In compose
# this is set for you and points straight at the `db` service.
#
# Note the `.teaser` suffix on the username. Host port 5432 is published by
# Supavisor (the pooler), not by Postgres, and Supavisor requires the tenant to
# be part of the user: <role>.<POOLER_TENANT_ID>. Without it the connection is
# refused with "(ENOIDENTIFIER) no tenant id". Inside compose the backend talks
# to db:5432 directly and uses the bare role name instead.
#
# NEVER point this at the `postgres` role: it has BYPASSRLS and would defeat
# every row level security policy.
DATABASE_URL=postgresql+psycopg://teaser_app.teaser:CHANGE_ME@localhost:5432/postgres

# Base URL of the Supabase API gateway, used to fetch the JWKS that access
# tokens are verified against. In compose this becomes http://api-gw:8000.
SUPABASE_URL=http://localhost:8000

# ---------- Storage ----------
# "local" is the only backend implemented in the prototype.
STORAGE_BACKEND=local
UPLOAD_DIR=./storage/uploads
GENERATED_DIR=./storage/generated

# ---------- Upload validation ----------
MAX_UPLOAD_MB=500
MAX_SOURCE_DURATION_SECONDS=7200
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.mkv,.webm

# ---------- Teaser output ----------
TEASER_MIN_SECONDS=20
TEASER_PREFERRED_MIN_SECONDS=30
TEASER_PREFERRED_MAX_SECONDS=60
TEASER_MAX_SECONDS=60
# How many teasers to generate per job.
TEASER_COUNT=3
# How many candidate moments to request from Gemini before ranking.
CANDIDATE_COUNT=8
# Fallback when a run does not choose one.  The generation form offers
# 16:9, 9:16, 1:1, 4:3 and 4:5 per run.
TEASER_ASPECT_RATIO=16:9
ENABLE_CAPTIONS=false

# ---------- FFmpeg ----------
# Leave as-is if ffmpeg/ffprobe are on PATH; otherwise use absolute paths.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ---------- Frontend ----------
# Consumed by Vite at build time (copy into frontend/.env if kept separate).
# In compose the backend is published on 8001 so it does not collide with the
# Supabase gateway on 8000.
VITE_API_BASE_URL=http://localhost:8001/api

# Supabase project URL and the PUBLISHABLE key. This key is safe in the browser
# bundle -- it identifies the project, not the user. Copy the value of
# SUPABASE_PUBLISHABLE_KEY from docker/supabase/.env.
# Never put SUPABASE_SECRET_KEY here: anything VITE_* is shipped to the client.
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------- Host ports (docker compose) ----------
BACKEND_PORT=8001
FRONTEND_PORT=3001
